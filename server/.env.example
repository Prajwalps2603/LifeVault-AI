# LifeVault Server — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Google OAuth (Phase 3) ───────────────────────────────────────────────────
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# ─── Google API Scopes Needed ─────────────────────────────────────────────────
# https://www.googleapis.com/auth/drive.file
# https://www.googleapis.com/auth/spreadsheets
# https://www.googleapis.com/auth/calendar.events

# ─── OCR Service (Phase 4) ────────────────────────────────────────────────────
# OCR_PROVIDER=google-vision
# GOOGLE_VISION_API_KEY=your-vision-api-key

# ─── AI Service (Phase 4/8) ───────────────────────────────────────────────────
# AI_PROVIDER=gemini
# GEMINI_API_KEY=your-gemini-api-key

# ─── JWT Secret ───────────────────────────────────────────────────────────────
# JWT_SECRET=your-very-long-random-secret

# ─── Encryption (Phase 2+) ────────────────────────────────────────────────────
# ENCRYPTION_KEY=your-32-char-encryption-key

# ─── IMPORTANT ────────────────────────────────────────────────────────────────
# Never put API keys directly in the mobile app.
# All sensitive operations go through this server.
